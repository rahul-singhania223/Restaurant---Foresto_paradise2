---
// Tandoor.astro — "From the Tandoor" menu section (Astro + Tailwind v3/v4, no config changes)

const u = (id: string, w = 600) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${w}&q=80`;

// Unsplash IDs below are UNVERIFIED best guesses — replace each with a real photo ID.
const hero = { src: u("1555939594-58d7cb561ad1", 1400), alt: "Charred tandoori chicken skewers over glowing coals" };

const dishes = [
  { name: "Tandoori Chicken", desc: "Classic half chicken marinated in yoghurt and spices, grilled to perfection.", price: 380, img: u("1599487488170-d11ec9c172f0") },
  { name: "Chicken Tikka", desc: "Boneless chicken pieces marinated with special spices and grilled in tandoor.", price: 360, img: u("1610057099443-fde8c4d50f91") },
  { name: "Malai Tikka", desc: "Tender chicken chunks marinated in creamy cashew and mild spices.", price: 380, img: u("1631452180519-c014fe946bc7") },
  { name: "Seekh Kebab", desc: "Minced meat blended with aromatic spices, grilled on skewers.", price: 340, img: u("1529042410759-befb1204b468") },
  { name: "Tandoori Paneer", desc: "Soft paneer marinated in yoghurt and spices, grilled to perfection.", price: 320, img: u("1567188040759-fb8a883dc6d8") },
  { name: "Tandoori Prawns", desc: "Juicy prawns marinated in house spices, chargrilled for a smoky taste.", price: 480, img: u("1565557623262-b51c2513a641") },
];

const perks = [
  { title: "Slow Cooked", note: "In traditional tandoor ovens", icon: `<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>` },
  { title: "Premium Spices", note: "Authentic blends for rich flavours", icon: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>` },
  { title: "Chef Crafted", note: "Perfectly grilled every time", icon: `<path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/>` },
];

const flame = perks[0].icon;
const inr = (n: number) => `₹${n.toLocaleString("en-IN")}`;

// Right edge of the photo panel (0–1 coordinates), shared by mask + gold outline
const edge = "M0.65,0 C0.8,0.12 0.94,0.3 0.98,0.55 C1,0.72 0.92,0.83 0.72,0.9 C0.5,0.98 0.2,0.99 0,0.96";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Mrs+Saint+Delafield&family=Playfair+Display:wght@600;700&display=swap"
  rel="stylesheet"
/>

<section
  id="tandoor"
  data-reveal="section"
  class="relative isolate overflow-hidden bg-[#F8F2E8] font-['DM_Sans',sans-serif] lg:flex"
>
  <!-- soft gold wash bottom -->
  <div class="pointer-events-none absolute -bottom-24 left-1/4 -z-10 h-56 w-[70%] rounded-[100%] bg-[#E6CFA0]/60 blur-3xl" aria-hidden="true"></div>

  <!-- ============ LEFT: PHOTO PANEL ============ -->
  <div class="relative h-[32rem] w-full shrink-0 sm:h-[38rem] lg:h-auto lg:min-h-[44rem] lg:w-[40%]">
    <div data-reveal="hero-image" class="absolute inset-0 overflow-hidden rounded-b-[2.5rem] bg-[#1a0f06] lg:rounded-none lg:[clip-path:url(#tandoor-edge)]">
      <img src={hero.src} alt={hero.alt} loading="lazy" class="h-full w-full object-cover object-[35%_60%]" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/10 to-black/60"></div>
    </div>

    <!-- gold outline along the curve -->
    <svg class="pointer-events-none absolute inset-0 hidden h-full w-full lg:block" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
      <path d={edge} fill="none" stroke="#E9D3A6" stroke-opacity="0.8" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
    </svg>

    <!-- circular badge -->
    <div data-reveal="badge" class="absolute left-6 top-6 h-32 w-32 text-[#E9D3A6] sm:h-40 sm:w-40 lg:left-[3%] lg:top-[11%] lg:h-44 lg:w-44">
      <svg viewBox="0 0 200 200" class="h-full w-full" aria-hidden="true">
        <circle cx="100" cy="100" r="96" fill="rgba(0,0,0,0.25)" stroke="currentColor" stroke-opacity="0.7"></circle>
        <circle cx="100" cy="100" r="60" fill="none" stroke="currentColor" stroke-opacity="0.25"></circle>
        <defs><path id="tandoor-ring" d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0"></path></defs>
        <text fill="currentColor" font-size="13" letter-spacing="4.2" font-family="DM Sans, sans-serif" font-weight="500">
          <textPath href="#tandoor-ring" startOffset="0">TRADITIONAL TANDOOR • RICHER FLAVOURS •</textPath>
        </text>
        <g transform="translate(76 76) scale(2)" fill="none" stroke="#F3DDB0" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" set:html={flame}></g>
      </svg>
    </div>

    <!-- script tagline -->
    <p data-reveal="tagline" class="absolute right-6 top-[9rem] -rotate-[9deg] font-['Mrs_Saint_Delafield',cursive] text-[2rem] leading-[0.92] text-white/90 [text-shadow:0_2px_14px_rgba(0,0,0,0.6)] sm:top-[11rem] sm:text-[2.7rem] lg:right-auto lg:left-[41%] lg:top-[22%] lg:text-[3rem]">
      <span class="block">Smoky</span>
      <span class="block pl-4">Flavours</span>
      <span class="block pl-8">Timeless</span>
      <span class="block pl-12">Tradition</span>
    </p>

    <!-- glass perks card -->
    <div data-reveal="perks" class="absolute inset-x-4 bottom-4 rounded-2xl border border-white/15 bg-[#3a2716]/60 px-3 py-5 text-center text-white backdrop-blur-md sm:inset-x-6 lg:bottom-[7%] lg:left-[5%] lg:right-auto lg:w-[88%] lg:px-5 lg:py-5">
      <ul class="grid grid-cols-3 gap-2">
        {
          perks.map((p) => (
            <li class="flex flex-col items-center">
              <span class="flex h-9 w-9 items-center justify-center rounded-full border border-[#D3A15A] text-[#E8B96B]">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
              </span>
              <h3 class="mt-2.5 text-[0.6rem] font-semibold uppercase tracking-[0.2em] sm:text-xs">{p.title}</h3>
              <p class="mt-1 max-w-[9rem] text-[0.65rem] leading-snug text-white/80 sm:text-sm">{p.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- ============ RIGHT: MENU ============ -->
  <div data-reveal="menu" class="relative z-10 flex-1 px-5 py-12 sm:px-8 lg:px-9 lg:py-14 xl:px-12">
    <!-- sketched leaves -->
    <svg class="pointer-events-none absolute right-24 top-0 hidden h-64 w-64 text-[#b9b2a6] opacity-50 xl:block" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
      <path d="M180 10C140 60 90 110 60 190"></path>
      <path d="M150 40c-25-5-45 10-55 35 25 5 50-5 55-35z"></path>
      <path d="M115 85c-25-5-45 10-52 35 25 3 48-8 52-35z"></path>
      <path d="M170 60c5 25-10 45-35 55-5-25 8-48 35-55z"></path>
    </svg>
    <svg class="pointer-events-none absolute -bottom-6 -right-6 hidden h-56 w-56 text-[#c9bfa9] opacity-50 lg:block" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
      <path d="M190 20C140 70 90 120 70 200"></path>
      <path d="M160 50c-25-5-45 10-55 35 25 5 50-5 55-35z"></path>
      <path d="M125 100c-25-5-45 10-52 35 25 3 48-8 52-35z"></path>
    </svg>

    <div data-reveal="eyebrow" class="flex items-center gap-4 text-[#B0701F]">
      <span class="h-px w-12 bg-current opacity-70 sm:w-16"></span>
      <p class="text-xs font-medium uppercase tracking-[0.35em]">From the Tandoor</p>
      <span class="h-px w-12 bg-current opacity-70 sm:w-16"></span>
    </div>

    <div data-reveal="heading" class="mt-6 flex items-start justify-between gap-6">
      <div>
        <h2 class="font-['Playfair_Display',serif] text-[clamp(3rem,5.4vw,5.5rem)] font-bold leading-none tracking-tight">
          <span class="text-[#0d0d0d]">Tan</span><span class="bg-gradient-to-b from-[#C98B34] to-[#A5651A] bg-clip-text text-transparent">door</span>
        </h2>
        <p class="mt-4 max-w-[34rem] text-[clamp(0.95rem,1.05vw,1.1rem)] leading-relaxed text-[#77706a]">
          Timeless favourites, grilled to perfection in our traditional tandoor. Experience the rich, smoky flavours in every bite.
        </p>
      </div>

      <div class="hidden h-28 w-28 shrink-0 flex-col items-center justify-center rounded-full border border-[#D9C7A6] text-center text-[#B0701F] 2xl:flex">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
        </svg>
        <p class="mt-3 max-w-[6rem] text-[0.6rem] font-medium uppercase leading-relaxed tracking-[0.25em]">Authentic Indian Flavours</p>
        <span class="mt-2 h-px w-8 bg-current opacity-60"></span>
      </div>
    </div>

    <ul class="mt-8 grid gap-3 md:grid-cols-2">
      {
        dishes.map((d) => (
          <li data-reveal="dish" class="flex gap-4 rounded-xl bg-white/40 p-2.5 sm:gap-4 sm:p-3">
            <img
              src={d.img}
              alt={d.name}
              loading="lazy"
              class="h-24 w-24 shrink-0 rounded-lg sm:h-28 sm:w-28 bg-[#2a1d12] object-cover sm:h-32 sm:w-32 xl:h-36 xl:w-36"
            />
            <div class="flex min-w-0 flex-1 flex-col">
              <h3 class="font-['Playfair_Display',serif] text-base font-semibold text-[#1c1a17] sm:text-lg">{d.name}</h3>
              <p class="mt-1.5 text-[13px] leading-[1.45] text-[#77706a]">{d.desc}</p>
              <div class="mt-auto flex items-end justify-between pt-3">
                <span class="text-lg font-semibold text-[#B0701F] sm:text-xl">{inr(d.price)}</span>
                <button
                  type="button"
                  aria-label={`Add ${d.name}`}
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-[#B0701F] text-[#B0701F] transition hover:bg-[#B0701F] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#B0701F]"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                </button>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <div data-reveal="cta" class="mt-8 flex justify-center">
      <a
        href="/menu"
        class="inline-flex items-center gap-3 rounded-full border border-[#B0701F] px-8 py-3.5 text-sm font-medium text-[#8f5a17] transition hover:bg-[#B0701F] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#B0701F]"
      >
        View More Tandoor Dishes
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </div>

  <!-- clip-path definition -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="tandoor-edge" clipPathUnits="objectBoundingBox">
        <path d={`M0,0 L${edge.slice(1)} Z`}></path>
      </clipPath>
    </defs>
  </svg>

 </section>

  <style>
    [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 800ms cubic-bezier(.22,1,.36,1),
        transform 900ms cubic-bezier(.22,1,.36,1);
    }

    [data-reveal="hero-image"] {
      transform: scale(1.045);
    }

    [data-reveal="badge"] { transform: translateY(14px) scale(.96); }
    [data-reveal="tagline"] { transform: translateY(18px) rotate(-9deg); }
    [data-reveal="dish"] { transform: translateY(20px); }
    [data-reveal="cta"] { transform: translateY(16px); }

    [data-reveal].is-visible {
      opacity: 1;
      transform: translate3d(0,0,0) scale(1) rotate(0);
    }

    [data-reveal="hero-image"].is-visible img {
      transform: scale(1);
    }

    [data-reveal="hero-image"] img {
      transform: scale(1.035);
      transition: transform 1400ms cubic-bezier(.22,1,.36,1);
    }

    [data-reveal="dish"]:nth-child(1) { transition-delay: 80ms; }
    [data-reveal="dish"]:nth-child(2) { transition-delay: 150ms; }
    [data-reveal="dish"]:nth-child(3) { transition-delay: 220ms; }
    [data-reveal="dish"]:nth-child(4) { transition-delay: 290ms; }
    [data-reveal="dish"]:nth-child(5) { transition-delay: 360ms; }
    [data-reveal="dish"]:nth-child(6) { transition-delay: 430ms; }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal],
      [data-reveal="hero-image"] img {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <script>
    const items = document.querySelectorAll("[data-reveal]");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      items.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          obs.unobserve(entry.target);
        });
      }, {
        threshold: 0.08,
        rootMargin: "0px 0px -6% 0px"
      });

      items.forEach((item) => observer.observe(item));
    }
  </script>

