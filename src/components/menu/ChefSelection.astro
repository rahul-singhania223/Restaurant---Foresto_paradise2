---
const dishes = [
  {
    name: "Paneer Lababdar",
    description:
      "Rich and creamy tomato gravy with soft paneer cubes, a true classic.",
    price: "₹320",
    badge: "♛  CHEF'S SPECIAL",
    image:
      "https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=1200&q=85",
  },
  {
    name: "Tandoori Chicken",
    description:
      "Succulent chicken marinated with exotic spices, grilled to perfection in a clay oven.",
    price: "₹380",
    badge: "♥  MOST LOVED",
    image:
      "https://images.unsplash.com/photo-1599487488170-d11ec9c172f0?auto=format&fit=crop&w=1200&q=85",
  },
  {
    name: "Hyderabadi Biryani",
    description:
      "Aromatic basmati rice cooked with tender meat and authentic spices.",
    price: "₹340",
    badge: "★  SIGNATURE",
    image:
      "https://images.unsplash.com/photo-1705174299330-939dd03cc864?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Nnx8YmlyeWFuaXxlbnwwfHwwfHx8MA%3D%3D",
  },
  {
    name: "Grilled Fish with Herbs",
    description:
      "Fresh catch grilled with herbs, served with seasonal vegetables and lemon butter sauce.",
    price: "₹420",
    badge: "◒  CHEF'S CHOICE",
    image:
      "https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?auto=format&fit=crop&w=1200&q=85",
  },
];
---

<section
  id="chef-selection"
  class="
    relative isolate overflow-hidden
    bg-[#F8F4EB]
    px-4 py-[54px]
    text-[#111111]
    sm:px-6 sm:py-[65px]
    lg:px-8 lg:py-[72px]
  "
>
  <!-- =====================================================
       RIGHT BOTANICAL DECORATION
  ====================================================== -->

  <div
    data-reveal="decor"
    aria-hidden="true"
    class="
      pointer-events-none absolute z-[1]
      -right-[95px] top-[65px]
      h-[300px] w-[230px]
      text-[#B9A991] opacity-[0.32]
      sm:-right-[60px]
      lg:right-[65px] lg:top-[7px]
      lg:h-[390px] lg:w-[315px]
      lg:opacity-60
    "
  >
    <svg
      viewBox="0 0 330 410"
      fill="none"
      class="h-full w-full"
    >
      <g opacity=".42">
        <path
          d="M177 392C181 320 187 254 204 189C219 131 237 77 272 19"
          stroke="currentColor"
          stroke-width="1.15"
        />

        <path
          d="M203 194C178 168 151 151 119 143C147 169 174 187 203 194Z"
          stroke="currentColor"
        />

        <path
          d="M211 169C235 144 259 128 290 119C264 144 239 160 211 169Z"
          stroke="currentColor"
        />

        <path
          d="M220 139C196 112 181 86 177 57C201 83 215 109 220 139Z"
          stroke="currentColor"
        />

        <path
          d="M231 111C258 88 282 77 311 74C286 94 260 106 231 111Z"
          stroke="currentColor"
        />

        <path
          d="M241 85C222 61 213 38 213 12C233 33 242 57 241 85Z"
          stroke="currentColor"
        />

        <path
          d="M193 227C164 213 136 208 106 212C136 226 165 233 193 227Z"
          stroke="currentColor"
        />

        <path
          d="M187 259C157 253 130 258 103 272C134 274 161 270 187 259Z"
          stroke="currentColor"
        />
      </g>
    </svg>
  </div>


  <!-- =====================================================
       LEFT BOTANICAL DECORATION
  ====================================================== -->

  <div
    data-reveal="decor"
    aria-hidden="true"
    class="
      pointer-events-none absolute z-[1]
      -bottom-5 -left-[75px]
      h-[210px] w-[210px]
      rotate-[-9deg]
      text-[#B9A991] opacity-[0.42]
      sm:-left-[35px]
      lg:-bottom-7 lg:-left-[15px]
      lg:h-[280px] lg:w-[300px]
    "
  >
    <svg
      viewBox="0 0 300 280"
      fill="none"
      class="h-full w-full"
    >
      <g opacity=".42">
        <path
          d="M15 278C55 228 99 190 145 164C189 139 231 118 279 83"
          stroke="currentColor"
          stroke-width="1.15"
        />

        <path
          d="M98 199C70 188 44 187 18 194C44 204 71 208 98 199Z"
          stroke="currentColor"
        />

        <path
          d="M125 177C99 153 80 132 71 106C95 124 113 148 125 177Z"
          stroke="currentColor"
        />

        <path
          d="M154 159C135 132 128 107 129 81C146 105 153 132 154 159Z"
          stroke="currentColor"
        />

        <path
          d="M180 143C179 111 185 87 199 65C198 96 192 120 180 143Z"
          stroke="currentColor"
        />
      </g>
    </svg>
  </div>


  <!-- =====================================================
       GOLD BRUSH DECORATION
  ====================================================== -->

  <div
    data-reveal="decor"
    aria-hidden="true"
    class="
      pointer-events-none absolute z-[1]
      -bottom-5 -right-20
      h-[155px] w-[300px]
      rotate-[-6deg]
      text-[#B88738] opacity-30
      sm:w-[370px]
      lg:-right-3 lg:-bottom-6
      lg:h-[155px] lg:w-[440px]
    "
  >
    <svg
      viewBox="0 0 520 180"
      fill="none"
      class="h-full w-full"
    >
      <g fill="none" stroke="currentColor">
        <path d="M30 130C130 95 260 75 490 15" stroke-width="10" />
        <path d="M60 151C170 116 310 92 505 35" stroke-width="5" />
        <path d="M20 158C160 120 310 103 450 60" stroke-width="3" />
        <path d="M110 165C210 139 325 124 475 79" stroke-width="2" />
      </g>
    </svg>
  </div>


  <!-- =====================================================
       CONTENT CONTAINER
  ====================================================== -->

  <div class="relative z-[3] mx-auto w-full max-w-[1630px]">


    <!-- ===================================================
         HEADER
    ==================================================== -->

    <header
      data-reveal="header"
      class="
        relative mb-7
        grid min-h-0
        grid-cols-1
        items-center
        lg:mb-[35px]
        lg:min-h-[235px]
        lg:grid-cols-[260px_1fr_150px]
        xl:grid-cols-[260px_1fr_150px]
      "
    >

      <!-- -----------------------------------------------
           SIGNATURE MARK
      ------------------------------------------------ -->

      <div
        aria-hidden="true"
        class="
          absolute hidden
          h-[190px] w-[220px]
          items-center justify-center
          text-[#9E691F]
          lg:relative lg:flex
        "
      >
        <!-- Signature -->
        <div
          class="
            relative z-[2]
            -rotate-[7deg]
            font-[cursive]
            text-left
            text-[38px]
            leading-[0.88]
          "
        >
          <span class="block">Signature</span>
          <span class="block">Dishes</span>
        </div>

        <!-- Circular text -->
        <div
          class="
            absolute inset-[12px_6px_5px]
            rotate-[-32deg]
            rounded-full
            font-sans
            text-[7px]
            font-medium
            tracking-[4px]
          "
        >
          <span class="absolute left-[36px] top-px whitespace-nowrap">
            FORESTO PARADISE
          </span>

          <span class="absolute right-[7px] top-[43px]">
            •
          </span>

          <span class="absolute bottom-1 right-[52px] whitespace-nowrap">
            EST. 1998
          </span>

          <span class="absolute bottom-[34px] left-[14px]">
            • SPECIALS
          </span>
        </div>
      </div>


      <!-- -----------------------------------------------
           CENTER HEADER
      ------------------------------------------------ -->

      <div class="text-center" data-reveal="header-center">

        <!-- Eyebrow -->
        <div
          class="
            flex items-center justify-center
            gap-[11px]
            font-sans
            text-[8px]
            font-medium
            tracking-[2.5px]
            text-[#A36A1D]
            sm:gap-4 sm:text-[10px]
            lg:gap-[18px] lg:text-[11px] lg:tracking-[4px]
          "
        >
          <span
            class="
              block h-px w-[35px]
              bg-[#BC8B48]
              sm:w-[45px]
              lg:w-[58px]
            "
          ></span>

          <!-- Leaf -->
          <div
            class="
              absolute
              top-[-3px]
              left-1/2
              h-[22px] w-[22px]
              -translate-x-1/2
              text-[#B67618]
            "
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              class="h-full w-full"
            >
              <path
                d="M12 20C12 13 13.8 7.8 20 4C20.3 10.9 17.2 15.4 12 16.9"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <path
                d="M12 20C12 14.7 10.2 9.2 4 7C4.2 13.1 7.4 16.6 12 17.5"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <path
                d="M12 20V5"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              />
            </svg>
          </div>

          <span>CHEF'S SELECTION</span>

          <span
            class="
              block h-px w-[35px]
              bg-[#BC8B48]
              sm:w-[45px]
              lg:w-[58px]
            "
          ></span>
        </div>


        <!-- Main Heading -->

        <h2
          class="
            mt-7
            font-serif
            text-[46px]
            font-semibold
            leading-[0.92]
            tracking-[-2px]
            text-[#111111]
            sm:text-[58px]
            lg:mt-[31px]
            lg:text-[clamp(60px,5.1vw,86px)]
            lg:tracking-[-3px]
          "
        >
          Chef’s {" "}
          <em
            class="
              font-normal
              not-italic
              text-[#B67518]
            "
          >
            Selection
          </em>
        </h2>


        <!-- Description -->

        <p
          class="
            mx-auto mt-3
            max-w-[720px]
            font-sans
            text-[13px]
            leading-[1.55]
            text-[#69655F]
            sm:text-[15px]
            lg:text-[16px]
            lg:leading-[1.65]
          "
        >
          A curated selection of our chef's most loved creations —
          crafted with the
          <br class="hidden lg:block" />
          finest ingredients and a passion for exceptional flavours.
        </p>

      </div>


      <!-- -----------------------------------------------
           RIGHT NOTE
      ------------------------------------------------ -->

      <div
        class="
          hidden
          flex-col items-start gap-[11px]
          justify-self-end
          text-[#8D867B]
          lg:flex
        "
      >
        <span class="h-px w-[47px] bg-[#C6A26D]"></span>

        <p
          class="
            m-0
            font-sans
            text-[8px]
            font-medium
            leading-[2]
            tracking-[2px]
          "
        >
          FRESH<br />
          INGREDIENTS<br />
          EXCEPTIONAL<br />
          FLAVOURS
        </p>

        <span class="h-px w-[47px] bg-[#C6A26D]"></span>
      </div>

    </header>


    <!-- =====================================================
         DISH GRID
    ====================================================== -->

    <div
      data-reveal="grid"
      class="
        grid
        grid-cols-1
        gap-[18px]
        sm:grid-cols-2 sm:gap-5
        lg:grid-cols-4 lg:gap-[27px]
      "
    >

      {dishes.map((dish) => (
        <article
          data-reveal="card"
          class="
            group
            overflow-hidden
            rounded-[17px]
            bg-[rgba(250,247,239,0.94)]
            shadow-[0_8px_24px_rgba(73,51,25,0.035),0_1px_1px_rgba(73,51,25,0.04)]
            transition-all
            duration-500
            ease-[cubic-bezier(.2,.75,.25,1)]
            hover:-translate-y-[7px]
            hover:shadow-[0_18px_42px_rgba(73,51,25,0.11),0_2px_3px_rgba(73,51,25,0.04)]
          "
        >

          <!-- Image -->
          <div
            class="
              relative
              h-[300px]
              overflow-hidden
              bg-[#211B15]
              sm:h-[310px]
              lg:h-[325px]
            "
          >
            <img
              src={dish.image}
              alt={dish.name}
              loading="lazy"
              class="
                block
                h-full w-full
                object-cover
                transition-transform
                duration-[800ms]
                ease-[cubic-bezier(.2,.75,.25,1)]
                group-hover:scale-[1.045]
              "
            />

            <!-- Image Overlay -->
            <div
              class="
                pointer-events-none
                absolute inset-0
                bg-[linear-gradient(180deg,rgba(0,0,0,.28)_0%,transparent_32%,transparent_68%,rgba(0,0,0,.12)_100%)]
              "
            ></div>


            <!-- Badge -->
            <span
              class="
                absolute left-[15px] top-[15px]
                inline-flex min-h-[35px]
                items-center
                rounded-full
                border
                border-[rgba(221,179,91,0.95)]
                bg-[rgba(17,14,10,0.55)]
                px-[14px]
                font-sans
                text-[10px]
                font-semibold
                tracking-[1.1px]
                text-white
                backdrop-blur-[5px]
                sm:left-5 sm:top-5
              "
            >
              {dish.badge}
            </span>
          </div>


          <!-- Card Content -->

          <div
            class="
              flex
              min-h-[178px]
              flex-col
              px-[22px]
              py-5
              sm:px-6
              lg:min-h-[190px]
              lg:px-[29px]
              lg:pb-5
              lg:pt-[22px]
            "
          >

            <h3
              class="
                mb-[9px]
                font-serif
                text-[24px]
                font-semibold
                leading-[1.05]
                tracking-[-0.35px]
                text-[#111111]
                lg:text-[25px]
              "
            >
              {dish.name}
            </h3>

            <p
              class="
                m-0
                max-w-[290px]
                font-sans
                text-[13px]
                leading-[1.55]
                text-[#77726B]
                lg:text-[14px]
              "
            >
              {dish.description}
            </p>


            <!-- Bottom -->

            <div
              class="
                mt-auto
                flex
                items-center
                justify-between
                pt-[15px]
              "
            >
              <span
                class="
                  font-sans
                  text-[19px]
                  font-semibold
                  tracking-[-0.2px]
                  text-[#9D600D]
                "
              >
                {dish.price}
              </span>


              <!-- Add Button -->

              <button
                type="button"
                aria-label={`Add ${dish.name}`}
                class="
                  relative
                  grid
                  h-[45px] w-[45px]
                  shrink-0
                  place-items-center
                  rounded-full
                  border-[1.5px]
                  border-[#B97818]
                  bg-transparent
                  transition-all
                  duration-300
                  hover:rotate-90
                  hover:bg-[#B97818]
                "
              >
                <span
                  class="
                    absolute
                    h-[1.5px] w-[14px]
                    bg-[#B97818]
                    transition-colors
                    duration-300
                    group-hover:bg-white
                  "
                ></span>

                <span
                  class="
                    absolute
                    h-[1.5px] w-[14px]
                    rotate-90
                    bg-[#B97818]
                    transition-colors
                    duration-300
                    group-hover:bg-white
                  "
                ></span>
              </button>

            </div>
          </div>

        </article>
      ))}

    </div>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <div
      data-reveal="cta"
      class="
        mt-[35px]
        flex
        justify-center
        lg:mt-[44px]
      "
    >
      <a
        href="/menu"
        class="
          group
          inline-flex
          h-[56px]
          w-full
          items-center
          justify-center
          gap-[23px]
          rounded-full
          border-[1.5px]
          border-[#BD7C1D]
          px-7
          font-sans
          text-[15px]
          font-medium
          text-[#814B0D]
          no-underline
          transition-all
          duration-300
          hover:-translate-y-0.5
          hover:bg-[#A96914]
          hover:text-white
          hover:shadow-[0_9px_25px_rgba(169,105,20,0.18)]
          sm:w-auto
          sm:min-w-[300px]
          lg:h-[59px]
          lg:text-[16px]
        "
      >
        <span>Explore Full Menu</span>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          class="
            h-[21px] w-[21px]
            stroke-current
            stroke-[1.5]
            transition-transform
            duration-300
            group-hover:translate-x-[5px]
          "
        >
          <path
            d="M4 12H19"
            stroke-linecap="round"
          />

          <path
            d="M13 6L19 12L13 18"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>

  </div>

  <style>
    /* Smooth, subtle section reveals — existing visual styles remain untouched. */
    [data-reveal] {
      opacity: 0;
      will-change: opacity, transform;
      transition:
        opacity 850ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 950ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-reveal="header"],
    [data-reveal="header-center"] {
      transform: translateY(30px);
    }

    [data-reveal="grid"] {
      transform: translateY(34px);
    }

    [data-reveal="card"] {
      transform: translateY(42px);
      transition-delay: var(--card-delay, 0ms);
    }

    [data-reveal="cta"] {
      transform: translateY(26px);
    }

    [data-reveal="decor"] {
      transform: translate3d(0, 24px, 0) scale(0.97);
      transition-duration: 1200ms;
    }

    [data-reveal].is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }

    /* Give each dish a natural stagger without changing the layout. */
    [data-reveal="card"]:nth-child(1) { --card-delay: 80ms; }
    [data-reveal="card"]:nth-child(2) { --card-delay: 180ms; }
    [data-reveal="card"]:nth-child(3) { --card-delay: 280ms; }
    [data-reveal="card"]:nth-child(4) { --card-delay: 380ms; }

    /* Gentle image movement while the section scrolls into view. */
    [data-reveal="card"] img {
      transform: scale(1.035);
      transition:
        transform 1100ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-reveal="card"].is-visible img {
      transform: scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal],
      [data-reveal="card"] img {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <script>
    const revealItems = document.querySelectorAll("[data-reveal]");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries, revealObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -7% 0px",
        }
      );

      revealItems.forEach((item) => observer.observe(item));
    }
  </script>

</section>