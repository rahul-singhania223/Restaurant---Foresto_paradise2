     <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4" data-reveal="item" style="--reveal-delay: 460ms;">
          <!-- PRIMARY -->
          <a
            href="#menu"
            class="group relative inline-flex h-14 items-center gap-3 overflow-hidden rounded-full bg-[#E8B875] px-6 text-[14px] font-semibold text-[#171714] shadow-[0_0_0_1px_rgba(255,220,165,0.35),0_8px_25px_rgba(168,115,67,0.35),0_0_45px_rgba(232,184,117,0.16)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#F0C98F] hover:shadow-[0_0_0_1px_rgba(255,225,180,0.55),0_10px_30px_rgba(168,115,67,0.45),0_0_55px_rgba(232,184,117,0.28)]"
          >
            <!-- Inner highlight -->
            <span
              class="pointer-events-none absolute inset-0 rounded-full bg-gradient-to-b from-white/30 via-transparent to-transparent opacity-70"
            ></span>

            <!-- Hover shimmer -->
            <span
              class="pointer-events-none absolute -left-1/2 top-0 h-full w-1/2 -skew-x-12 bg-gradient-to-r from-transparent via-white/35 to-transparent opacity-0 transition-all duration-700 group-hover:left-[120%] group-hover:opacity-100"
            ></span>

            <!-- Cutlery -->
            <svg
              viewBox="0 0 24 24"
              fill="none"
              class="relative z-10 h-[18px] w-[18px]"
              aria-hidden="true"
            >
              <path
                d="M8 3V21M5 3V9C5 10.7 6.3 12 8 12C9.7 12 11 10.7 11 9V3M16 3V21M13.5 3C16 3.8 18 6.2 18 9V21"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <span class="relative z-10">
              Explore Our Menu
            </span>

            <!-- Arrow -->
            <svg
              viewBox="0 0 24 24"
              fill="none"
              class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path
                d="M5 12H19M13 6L19 12L13 18"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>

          <!-- SECONDARY -->
          <a
            href="#reservation"
            class="group inline-flex h-14 items-center gap-3 rounded-full border border-white/30 bg-white/[0.04] px-6 text-[14px] font-medium text-white backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-[#C99A69] hover:bg-[#A87343]/10 hover:text-[#E8C596]"
          >
            <svg
