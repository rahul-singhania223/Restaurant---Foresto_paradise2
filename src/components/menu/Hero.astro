---

<div class="relative min-h-screen bg-[#0a0a0a] text-white font-sans overflow-hidden flex flex-col">
  
  <!-- Background Image Placeholder -->
  <div class="absolute inset-0 z-0 hero-bg" data-reveal="fade">
    <img src="/images/hero-restaurant.webp" alt="Restaurant interior and dish" class="w-full h-full object-cover opacity-65" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
  </div>

  <!-- Navbar -->
  <div data-reveal="nav"><Navbar /></div>

  <!-- Main Content Area -->
  <main class="relative z-10 flex-grow flex flex-col justify-center px-12 pb-32 pt-8 w-full md:w-3/5 lg:w-1/2 hero-content" data-reveal="content">
   

    <!-- Section Label -->
    <div class="flex items-center gap-4 mb-5" data-reveal="item" style="--reveal-delay: 120ms;">
      <span class="text-[0.65rem] font-bold tracking-[0.25em] text-[#DEB27D] uppercase">Our Menu</span>
      <div class="w-12 h-[1px] bg-[#DEB27D]/50"></div>
    </div>

    <!-- Headline -->
      <!-- =================================================
             MAIN HEADLINE
             ================================================= -->

        <h1 data-reveal="item" style="--reveal-delay: 220ms;"
          class="max-w-[650px] font-['Cormorant_Garamond'] text-[clamp(4.2rem,6.4vw,6rem)] font-medium leading-[0.82] tracking-[-0.035em]"
        >
          <!-- White -->
          <span class="block text-[#FAF9F5]">
            Flaours For
          </span>

          <!-- Warm cream / bronze -->
          <!-- <span
            class="block bg-gradient-to-r from-[#FFF4DD] via-[#F0C98F] to-[#D99D5F] bg-clip-text text-transparent"
          >
            For
          </span> -->

          <span
