          </a>
     </div>
  </main>

  <!-- Bottom Navigation / Categories Bar -->
  <div class="relative z-10 w-full px-12 pb-8 pt-8">
    
    <!-- Background blur and border for the bottom pane -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent pointer-events-none"></div>
    <div class="relative border-t border-white/10 pt-8 flex items-end justify-between" data-reveal="item" style="--reveal-delay: 160ms;">
      
      <!-- Categories -->
      <div class="flex gap-12 lg:gap-16" data-reveal="categories">
        <!-- Signature Dishes -->
        <a href="#" class="flex flex-col items-center gap-3 group">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-gray-400 group-hover:text-[#DEB27D] transition-colors"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"></path><line x1="6" y1="17" x2="18" y2="17"></line></svg>
          <span class="text-[0.65rem] text-gray-400 group-hover:text-white transition-colors tracking-wide">Signature Dishes</span>
        </a>

        <!-- Starters -->
        <a href="#" class="flex flex-col items-center gap-3 group">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-gray-400 group-hover:text-[#DEB27D] transition-colors"><path d="M2 12h20"></path><path d="M20 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="M10 3.5c-.7 1.4-1.3 2.1-3 2.1"></path><path d="M14 3.5c-.7 1.4-1.3 2.1-3 2.1"></path><path d="M18 3.5c-.7 1.4-1.3 2.1-3 2.1"></path></svg>
          <span class="text-[0.65rem] text-gray-400 group-hover:text-white transition-colors tracking-wide">Starters</span>
        </a>

        <!-- Main Course -->
        <a href="#" class="flex flex-col items-center gap-3 group">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-gray-400 group-hover:text-[#DEB27D] transition-colors"><path d="M3 21h18"></path><path d="M5 21V17a7 7 0 0 1 14 0v4"></path><path d="M12 10v-.5a1.5 1.5 0 0 0-3 0V10"></path></svg>
          <span class="text-[0.65rem] text-gray-400 group-hover:text-white transition-colors tracking-wide">Main Course</span>
        </a>

        <!-- Breads & Rice -->
        <a href="#" class="flex flex-col items-center gap-3 group">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-gray-400 group-hover:text-[#DEB27D] transition-colors"><path d="M12 2C7 2 3 7 3 12c0 2 .5 3 2 4l-1 4 4-1c1 1.5 2 2 4 2 5 0 9-5 9-10S17 2 12 2Z"></path></svg>
          <span class="text-[0.65rem] text-gray-400 group-hover:text-white transition-colors tracking-wide">Breads & Rice</span>
        </a>

        <!-- Desserts -->
        <a href="#" class="flex flex-col items-center gap-3 group">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-gray-400 group-hover:text-[#DEB27D] transition-colors"><rect x="2" y="10" width="20" height="12" rx="2"></rect><path d="M2 14h20"></path><path d="M12 10V6"></path><path d="M10 4h4"></path></svg>
          <span class="text-[0.65rem] text-gray-400 group-hover:text-white transition-colors tracking-wide">Desserts</span>
        </a>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute left-1/2 -translate-x-1/2 bottom-8 flex flex-col items-center gap-3" data-reveal="scroll-indicator">
        <div class="w-[1px] h-6 bg-gray-500/50"></div>
        <div class="w-5 h-[26px] border-[1.5px] border-gray-400 rounded-full flex justify-center p-1">
          <div class="w-1 h-1.5 bg-gray-400 rounded-full animate-bounce"></div>
        </div>
        <span class="text-[0.55rem] text-gray-400 tracking-[0.2em]">SCROLL TO EXPLORE</span>
      </div>
      
    </div>
  </div>

  <style>
    /* ---------------------------------------------------------
       Smooth reveal + scroll motion
       Visual design/layout remains unchanged.
       --------------------------------------------------------- */

    [data-reveal] {
      opacity: 0;
      will-change: opacity, transform;
      transition:
        opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 1000ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-reveal="fade"] {
      transform: scale(1.035);
    }

    [data-reveal="nav"] {
      transform: translateY(-14px);
    }

    [data-reveal="content"],
    [data-reveal="item"] {
      transform: translateY(28px);
    }

    [data-reveal="categories"] {
      transform: translateY(18px);
    }

    [data-reveal="scroll-indicator"] {
      transform: translateY(12px);
    }

    [data-reveal].is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }

    .hero-bg img {
      transform: scale(1.035);
      will-change: transform;
      transition: transform 1200ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hero-bg.is-visible img {
      transform: scale(1);
    }

    /* Slightly slower stagger for the main content. */
    [data-reveal="item"].is-visible {
      transition-delay: var(--reveal-delay, 0ms);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal],
      .hero-bg img {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <script>
    const revealItems = document.querySelectorAll("[data-reveal]");

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.08,
          rootMargin: "0px 0px -5% 0px",
        }
      );

      revealItems.forEach((item) => revealObserver.observe(item));

      // Subtle vertical background movement while scrolling.
      const heroBackground = document.querySelector(".hero-bg");
      let ticking = false;

      const updateParallax = () => {
        if (!heroBackground) return;

        const scrollY = window.scrollY;
        const offset = Math.min(scrollY * 0.12, 90);

        heroBackground.style.transform =
          `translate3d(0, ${offset}px, 0)`;

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(updateParallax);
          ticking = true;
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      updateParallax();
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }
  </script>

</div>