---
const categories = ["All", "Soups", "Salads"];

const dishes = [
  {
    name: "Cream of Tomato Soup",
    description:
      "Classic tomato soup finished with fresh cream and herbs.",
    price: "₹220",
    category: "Soups",
    type: "vegetarian",
    image:
      "https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1200&q=88",
  },
  {
    name: "Cream of Mushroom Soup",
    description:
      "Silky mushroom soup with a hint of garlic and fresh herbs.",
    price: "₹240",
    category: "Soups",
    type: "vegetarian",
    image:
      "https://images.unsplash.com/photo-1547592166-23ac45744acd?auto=format&fit=crop&w=1200&q=88",
  },
  {
    name: "Vegetable Clear Soup",
    description:
      "A light and healthy broth with seasonal vegetables.",
    price: "₹210",
    category: "Soups",
    type: "vegetarian",
    image:
      "https://images.unsplash.com/photo-1603105037880-880cd4edfb0d?auto=format&fit=crop&w=1200&q=88",
  },
  {
    name: "Classic Caesar Salad",
    description:
      "Crisp romaine lettuce, parmesan cheese and homemade dressing.",
    price: "₹320",
    category: "Salads",
    type: "vegetarian",
    image:
      "https://images.unsplash.com/photo-1550304943-4f24f54ddde9?auto=format&fit=crop&w=1200&q=88",
  },
  {
    name: "Greek Salad",
    description:
      "Fresh garden vegetables, olives and feta cheese with olive oil.",
    price: "₹300",
    category: "Salads",
    type: "vegetarian",
    image:
      "https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=1200&q=88",
  },
  {
    name: "Grilled Chicken Salad",
    description:
      "Tender grilled chicken with fresh greens and citrus dressing.",
    price: "₹360",
    category: "Salads",
    type: "non-vegetarian",
    image:
      "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=1200&q=88",
  },
];
---

<section
  id="soups-salads"
  class="relative isolate overflow-hidden bg-[#F8F4EB] px-4 py-14 text-[#111111] sm:px-6 lg:px-8 lg:py-[58px]"
>
  <!-- =====================================================
       BACKGROUND BOTANICAL
  ====================================================== -->

  <div
    aria-hidden="true"
    data-reveal="botanical" class="pointer-events-none absolute left-[28%] top-[20px] z-0 hidden h-[235px] w-[300px] text-[#B7A991] opacity-50 lg:block"
  >
    <svg
      viewBox="0 0 300 235"
      fill="none"
      class="h-full w-full"
    >
      <path
        d="M28 225C73 181 108 137 136 88C153 58 164 29 169 5"
        stroke="currentColor"
        stroke-width="1"
      />

      <path
        d="M137 88C111 72 87 62 59 61C84 79 110 87 137 88Z"
        stroke="currentColor"
      />

      <path
        d="M149 67C172 47 195 35 222 30C199 49 175 61 149 67Z"
        stroke="currentColor"
      />

      <path
        d="M157 48C143 28 138 13 139 -5C154 13 160 29 157 48Z"
        stroke="currentColor"
      />

      <path
        d="M171 36C190 17 207 7 230 2C214 20 194 31 171 36Z"
        stroke="currentColor"
      />

      <path
        d="M113 125C89 111 66 106 40 108C64 122 88 128 113 125Z"
        stroke="currentColor"
      />
    </svg>
  </div>


  <!-- =====================================================
       BOTTOM LEFT SOFT IMAGE ATMOSPHERE
  ====================================================== -->

  <div
    aria-hidden="true"
    data-reveal="atmosphere" class="pointer-events-none absolute bottom-0 left-0 z-0 h-[390px] w-[420px] bg-[radial-gradient(circle_at_30%_80%,rgba(154,122,80,0.16),transparent_65%)] blur-2xl"
  ></div>


  <!-- =====================================================
       MAIN CONTAINER
  ====================================================== -->

  <div
    data-reveal="container" class="relative z-[2] mx-auto grid w-full max-w-[1510px] grid-cols-1 gap-8 lg:grid-cols-[430px_minmax(0,1fr)] lg:gap-[26px] xl:grid-cols-[430px_minmax(0,1fr)]"
  >

    <!-- ===================================================
         LEFT EDITORIAL COLUMN
    ==================================================== -->

    <div
      data-reveal="editorial" class="relative min-h-[700px] overflow-visible lg:min-h-[850px]"
    >

      <!-- -----------------------------------------------
           EYEBROW
      ------------------------------------------------ -->

      <div
        data-reveal="item" style="--reveal-delay: 80ms;" class="flex items-center gap-4 font-sans text-[9px] font-medium tracking-[4px] text-[#A36A1D] sm:text-[10px]"
      >
        <span class="h-px w-[48px] bg-[#BC8B48] sm:w-[70px]"></span>

        <span>FRESH &amp; WHOLESOME</span>

        <span class="h-px w-[48px] bg-[#BC8B48] sm:w-[70px]"></span>
      </div>


      <!-- -----------------------------------------------
           TITLE
      ------------------------------------------------ -->

      <div data-reveal="item" style="--reveal-delay: 180ms;" class="relative mt-9 sm:mt-10 lg:mt-[55px]">

        <h2
          class="relative z-[2] font-serif text-[68px] font-medium leading-[0.86] tracking-[-3px] text-[#101010] sm:text-[82px] lg:text-[86px] xl:text-[92px]"
        >
          Soups &amp;
          <br />

          <span class="text-[#B67518]">
            Salads
          </span>
        </h2>

      </div>


      <!-- -----------------------------------------------
           DESCRIPTION
      ------------------------------------------------ -->

      <p
        data-reveal="item" style="--reveal-delay: 300ms;" class="relative z-[2] mt-7 max-w-[375px] font-sans text-[18px] leading-[1.58] text-[#6F6A63] sm:text-[20px] lg:text-[21px]"
      >
        Light, refreshing and full of flavour —
        our soups and salads are crafted with
        fresh ingredients to bring balance
        to your meal.
      </p>


      <!-- -----------------------------------------------
           LARGE SOUP IMAGE
      ------------------------------------------------ -->

     


      <!-- -----------------------------------------------
           HANDWRITTEN QUOTE
      ------------------------------------------------ -->

      <div
        data-reveal="quote" class="absolute bottom-[70px] left-[10px] z-[3] rotate-[-7deg] sm:bottom-[65px] sm:left-[15px]"
      >
        <p
          class="font-[cursive] text-[27px] leading-[0.93] text-[#A46B20] sm:text-[31px]"
        >
          Fresh
          <br />
          Ingredients
          <br />
          Better Moments
        </p>

        <span
          class="mt-3 block h-px w-[48px] rotate-[-12deg] bg-[#A46B20]"
        ></span>
      </div>

    </div>


    <!-- ===================================================
         RIGHT CONTENT
    ==================================================== -->

    <div data-reveal="right" class="relative">

      

      <div
        data-reveal="filters" class="mb-[28px] flex items-center justify-between gap-4 sm:mb-[30px]"
      >

        <!-- Filters -->

        <div
          class="flex items-center gap-2 rounded-full"
        >
          {categories.map((category, index) => (
            <button
              type="button"
              class:list={[
                "rounded-full px-[24px] py-[11px] font-sans text-[12px] font-medium transition-all duration-300",
                index === 0
                  ? "bg-[#B57618] text-white shadow-[0_5px_15px_rgba(181,118,24,0.18)]"
                  : "bg-[#EFE8DC] text-[#956329] hover:bg-[#E7DDCC]",
              ]}
            >
              {category}
            </button>
          ))}
        </div>


        <!-- Count -->

        <div
          class="hidden items-center gap-4 font-sans text-[9px] font-medium tracking-[3.5px] text-[#A36A1D] sm:flex"
        >
          <span class="h-px w-[45px] bg-[#BC8B48]"></span>

          <span>06 ITEMS</span>
        </div>

      </div>


      <!-- Mobile count -->

      <div
        data-reveal="mobile-count" class="mb-5 flex items-center gap-3 font-sans text-[9px] font-medium tracking-[3px] text-[#A36A1D] sm:hidden"
      >
        <span class="h-px w-[35px] bg-[#BC8B48]"></span>
        <span>06 ITEMS</span>
      </div>


      <!-- -----------------------------------------------
           PRODUCT GRID
      ------------------------------------------------ -->

      <div
        data-reveal="grid" class="grid grid-cols-1 gap-[18px] sm:grid-cols-2 lg:grid-cols-3 lg:gap-[21px]"
      >

        {dishes.map((dish, index) => (
          <article
            data-reveal="card" style={`--card-delay: ${index * 90}ms;`} class="group overflow-hidden rounded-[15px] bg-[rgba(250,247,239,0.96)] shadow-[0_7px_22px_rgba(73,51,25,0.035)] transition-all duration-500 ease-[cubic-bezier(.2,.75,.25,1)] hover:-translate-y-1 hover:shadow-[0_17px_36px_rgba(73,51,25,0.1)]"
          >

            <!-- IMAGE -->

            <div
              class="relative h-[190px] overflow-hidden bg-[#272016] sm:h-[185px] lg:h-[193px]"
            >

              <img
                src={dish.image}
                alt={dish.name}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(.2,.75,.25,1)] group-hover:scale-[1.045]"
              />

              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/10 via-transparent to-black/10"
              ></div>

            </div>


            <!-- CONTENT -->

            <div
              class="flex min-h-[194px] flex-col px-[25px] pb-[16px] pt-[16px] sm:min-h-[190px] lg:px-[26px]"
            >

              <!-- Food Type -->

              <div class="flex items-center gap-[9px]">

                {dish.type === "vegetarian" ? (
                  <>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      class="h-[14px] w-[14px] text-[#55752A]"
                    >
                      <path
                        d="M19.5 4.5C11 5 5.2 9.5 5.2 16.2C10.8 16.2 17.3 12.4 19.5 4.5Z"
                        fill="currentColor"
                      />

                      <path
                        d="M5.5 19C9 14.8 12.5 11.2 17.8 7.5"
                        stroke="#F8F4EB"
                        stroke-width="1"
                        stroke-linecap="round"
                      />
                    </svg>

                    <span
                      class="font-sans text-[9px] font-medium tracking-[1.6px] text-[#5B703D]"
                    >
                      VEGETARIAN
                    </span>
                  </>
                ) : (
                  <>
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-[14px] w-[14px] text-[#B33125]"
                    >
                      <path
                        d="M12.5 3C13.3 6.8 11.2 8.5 10.1 10.3C9.2 11.7 9.3 13.2 10.5 14.4C10.5 12.4 11.7 11.1 13.3 10.4C15.8 12.2 16.7 14.3 15.9 16.3C15.3 18 13.9 19 12 19C9.4 19 7.4 17.2 7.3 14.8C7.2 12.4 8.5 10.5 10.2 8.6C11.8 6.8 12.4 5 12.5 3Z"
                      />
                    </svg>

                    <span
                      class="font-sans text-[9px] font-medium tracking-[1.3px] text-[#A23B31]"
                    >
                      NON-VEGETARIAN
                    </span>
                  </>
                )}

              </div>


              <!-- Name -->

              <h3
                class="mt-[13px] font-serif text-[21px] font-semibold leading-[1.05] tracking-[-0.35px] text-[#111] sm:text-[20px] lg:text-[21px]"
              >
                {dish.name}
              </h3>


              <!-- Description -->

              <p
                class="mt-[8px] max-w-[250px] font-sans text-[12px] leading-[1.5] text-[#77726B]"
              >
                {dish.description}
              </p>


              <!-- Bottom -->

              <div
                class="mt-auto flex items-center justify-between pt-4"
              >

                <span
                  class="font-sans text-[19px] font-semibold tracking-[-0.3px] text-[#A4650D]"
                >
                  {dish.price}
                </span>


                <!-- Plus -->

                <button
                  type="button"
                  aria-label={`Add ${dish.name}`}
                  class="relative grid h-[43px] w-[43px] place-items-center rounded-full border-[1.5px] border-[#B97818] transition-all duration-300 hover:rotate-90 hover:bg-[#B97818]"
                >
                  <span
                    class="absolute h-[1.5px] w-[13px] bg-[#B97818] transition-colors duration-300 group-hover:bg-white"
                  ></span>

                  <span
                    class="absolute h-[1.5px] w-[13px] rotate-90 bg-[#B97818] transition-colors duration-300 group-hover:bg-white"
                  ></span>
                </button>

              </div>

            </div>

          </article>
        ))}

      </div>

  </div>

  </div>

</section>
<style>
  /* Smooth, soft reveal animations — existing visual design untouched */
  [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 26px, 0);
    will-change: opacity, transform;
    transition:
      opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 1000ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal="botanical"] {
    transform: translate3d(0, -10px, 0) scale(0.98);
  }

  [data-reveal="atmosphere"] {
    transform: scale(1.04);
  }

  [data-reveal="food"] {
    transform: translate3d(-24px, 30px, 0) scale(0.96);
  }

  [data-reveal="quote"] {
    transform: translate3d(-10px, 18px, 0) rotate(-7deg);
  }

  [data-reveal="card"] {
    transform: translate3d(0, 30px, 0);
    transition-delay: var(--card-delay, 0ms);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  [data-reveal="quote"].is-visible {
    transform: translate3d(0, 0, 0) rotate(-7deg);
  }

  [data-reveal="card"] img {
    transform: scale(1.035);
    transition: transform 1200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal="card"].is-visible img {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    [data-reveal="card"] img {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const animatedElements = document.querySelectorAll("[data-reveal]");

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    animatedElements.forEach((element) => element.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries, revealObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        });
      },
      {
        threshold: 0.08,
        rootMargin: "0px 0px -6% 0px",
      }
    );

    animatedElements.forEach((element) => observer.observe(element));
  }
</script>

</section>