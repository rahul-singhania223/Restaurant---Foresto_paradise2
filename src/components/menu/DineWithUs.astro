---
// DineWithUs.astro — "Dine with us" reservation section (Astro + Tailwind v3/v4, no config changes)

// Unsplash ID is an UNVERIFIED best guess — swap for a real warm, candle-lit restaurant interior shot.
const image = {
  src: "https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1400&q=80",
  alt: "Candle-lit restaurant table set with a napkin, wine glass and warm lamps",
};

const cta = {
  reserveHref: "/reservations", // TODO: real route
  phoneHref: "tel:+910000000000", // TODO: real number
};

const icons = {
  calendar: `<path d="M8 2v4M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/>`,
  users: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  star: `<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>`,
  leaf: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
  chef: `<path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/>`,
  heart: `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>`,
  phone: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>`,
  lotus: `<path d="M12 4c1.6 2.2 1.6 5.4 0 8.5-1.6-3.1-1.6-6.3 0-8.5z"/><path d="M4.5 8.5c3.2 0 6 2 7.5 6-4.2 0-7.5-2-7.5-6z"/><path d="M19.5 8.5c-3.2 0-6 2-7.5 6 4.2 0 7.5-2 7.5-6z"/><path d="M6 18.5c4 1.2 8 1.2 12 0"/>`,
};

const highlights = [
  { label: "Reserve a table", icon: icons.calendar },
  { label: "Perfect for every occasion", icon: icons.users },
  { label: "Exceptional dining experience", icon: icons.star },
];

const values = [
  { label: "Fresh ingredients", icon: icons.leaf },
  { label: "Expertly crafted dishes", icon: icons.chef },
  { label: "Warm hospitality", icon: icons.heart },
  { label: "A place for everyone", icon: icons.users },
];

// Left edge of the photo (0–1 coordinates), shared by mask + gold outline
const edge = "M0.02,0 C0.06,0.12 0.2,0.2 0.24,0.4 C0.28,0.6 0.34,0.62 0.28,0.8 C0.24,0.92 0.19,0.97 0.17,1";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@700&display=swap"
  rel="stylesheet"
/>

<section
  id="dine-with-us"
  class="relative isolate flex flex-col overflow-hidden bg-[#FBF7F0] font-['DM_Sans',sans-serif]"
>
  <!-- gold brush arcs, bottom corners -->
  <div class="pointer-events-none absolute -bottom-28 -left-24 -z-10 h-64 w-64 rounded-full border-[14px] border-[#D9BC84]/40 blur-[2px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 -right-20 -z-10 h-64 w-72 rounded-full border-[12px] border-[#D9BC84]/30 blur-[2px]" aria-hidden="true"></div>

  <div class="relative lg:min-h-[37rem]">
    <!-- sketched leaf behind headline -->
    <svg class="pointer-events-none absolute left-[34%] top-6 hidden h-[26rem] w-80 text-[#b9b2a6] opacity-50 lg:block" viewBox="0 0 200 300" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
      <path d="M60 10C70 90 110 200 150 290"></path>
      <path d="M62 40c-30 10-45 40-40 70 30-5 45-35 40-70z"></path>
      <path d="M68 60c25-15 55-10 75 10-25 20-55 20-75-10z"></path>
      <path d="M90 130c-25 5-45 25-48 55 28-2 48-25 48-55z"></path>
      <path d="M100 150c25-10 50 0 65 20-25 15-50 10-65-20z"></path>
    </svg>

    <!-- CONTENT -->
    <div data-reveal="content" class="relative z-10 px-6 pb-12 pt-14 sm:px-10 lg:w-[58%] lg:pb-0 lg:pl-[5.5%] lg:pr-4 lg:pt-10">
      <div data-reveal="eyebrow" class="flex flex-col items-start gap-1 text-[#B0701F] lg:w-[34rem]">
        <svg class="ml-[12.5rem] hidden h-5 w-5 lg:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.lotus}></svg>
        <div class="flex w-full items-center gap-4">
          <span class="hidden h-px flex-1 bg-current opacity-50 sm:block"></span>
          <p class="text-xs font-medium uppercase tracking-[0.35em]">Dine with us</p>
          <span class="hidden h-px flex-1 bg-current opacity-50 sm:block"></span>
        </div>
      </div>

      <h2 data-reveal="title" class="mt-7 font-['Playfair_Display',serif] text-[clamp(2.45rem,4.5vw,4.6rem)] font-bold leading-[1.02] tracking-tight">
        <span class="block text-[#0d0d0d]">Good Food</span>
        <span class="block bg-gradient-to-r from-[#A5651A] to-[#C98B34] bg-clip-text text-transparent">Deserves Great Company</span>
      </h2>

      <p data-reveal="body" class="mt-5 max-w-lg text-[clamp(0.95rem,1.05vw,1.1rem)] leading-relaxed text-[#77706a]">
        Whether it's a casual meal, a special celebration or a business gathering — we're here to make it memorable.
      </p>

      <ul data-reveal="highlights" class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-0">
        {
          highlights.map((h, i) => (
            <li data-reveal="highlight-item" style={`--reveal-delay: ${i * 90}ms`} class:list={["flex items-center gap-4 sm:pr-6", i > 0 && "sm:border-l sm:border-[#D9C7A6] sm:pl-6"]}>
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#F1E4D0] text-[#B0701F]">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={h.icon} />
              </span>
              <span class="max-w-[9rem] text-[0.7rem] font-medium uppercase leading-relaxed tracking-[0.2em] text-[#4a453f]">{h.label}</span>
            </li>
          ))
        }
      </ul>

      <div data-reveal="actions" class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={cta.reserveHref}
          class="inline-flex items-center gap-3 rounded-full bg-[#B0701F] px-7 py-3.5 text-sm font-medium text-white shadow-[0_8px_20px_-8px_rgba(176,112,31,0.7)] transition hover:bg-[#8f5a17] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#B0701F]"
        >
          Make a Reservation
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a
          href={cta.phoneHref}
          class="inline-flex items-center gap-3 rounded-full border border-[#B0701F] px-7 py-3.5 text-sm font-medium text-[#8f5a17] transition hover:bg-[#B0701F] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#B0701F]"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" set:html={icons.phone}></svg>
          Call Us
        </a>
      </div>
    </div>

    <!-- IMAGE -->
    <div data-reveal="image" class="relative h-80 w-full sm:h-96 lg:absolute lg:right-0 lg:top-0 lg:h-[78%] lg:w-[52%]">
      <div class="h-full w-full overflow-hidden bg-[#2a1d12] lg:[clip-path:url(#dine-edge)]">
        <img src={image.src} alt={image.alt} loading="lazy" class="h-full w-full object-cover object-[60%_55%]" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1a0f06]/30 to-transparent"></div>
      </div>

      <!-- gold outline following the curve -->
      <svg class="pointer-events-none absolute inset-0 hidden h-full w-full lg:block" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
        <path d={edge} fill="none" stroke="#fff" stroke-opacity="0.5" stroke-width="16" vector-effect="non-scaling-stroke" class="blur-[4px]"></path>
        <path d={edge} fill="none" stroke="#D3A15A" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
      </svg>

      <!-- round badge -->
      <div data-reveal="badge" class="absolute bottom-6 right-6 h-24 w-24 text-[#E9D3A6] sm:h-28 sm:w-28 lg:bottom-auto lg:right-[3%] lg:top-[47%] lg:h-32 lg:w-32">
        <svg viewBox="0 0 200 200" class="h-full w-full" aria-hidden="true">
          <circle cx="100" cy="100" r="96" fill="rgba(20,12,6,0.55)" stroke="currentColor" stroke-opacity="0.6"></circle>
          <defs><path id="dine-ring" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0"></path></defs>
          <text fill="currentColor" font-size="14" letter-spacing="4.5" font-family="DM Sans, sans-serif" font-weight="500">
            <textPath href="#dine-ring" startOffset="0">GOOD FOOD • BETTER MOMENTS •</textPath>
          </text>
          <g transform="translate(76 76) scale(2.2)" fill="none" stroke="#F3DDB0" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" set:html={icons.lotus}></g>
        </svg>
      </div>
    </div>
  </div>

  <!-- VALUES STRIP -->
  <div data-reveal="values" class="relative z-10 mx-4 mb-5 mt-1 rounded-2xl bg-[#F3EADB]/80 px-4 py-5 backdrop-blur-sm sm:mx-6 lg:mx-8 lg:mt-0 lg:px-6">
    <ul class="grid grid-cols-2 gap-y-6 lg:grid-cols-4">
      {
        values.map((v, i) => (
          <li data-reveal="value-item" style={`--reveal-delay: ${i * 80}ms`} class:list={["flex items-center justify-center gap-4 px-3", i > 0 && "lg:border-l lg:border-[#D9C7A6]"]}>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center text-[#B0701F]">
              <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={v.icon} />
            </span>
            <span class="max-w-[8rem] text-[0.65rem] font-medium uppercase leading-relaxed tracking-[0.22em] text-[#4a453f] sm:text-xs">{v.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- clip-path definition -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="dine-edge" clipPathUnits="objectBoundingBox">
        <path d={`${edge} L1,1 L1,0 Z`}></path>
      </clipPath>
    </defs>
  </svg>

  <style>
    [data-reveal] {
      opacity: 0;
      transform: translate3d(0, 22px, 0);
      will-change: opacity, transform;
      transition:
        opacity 800ms cubic-bezier(.22,1,.36,1),
        transform 850ms cubic-bezier(.22,1,.36,1);
    }

    [data-reveal="image"] {
      transform: translate3d(18px, 0, 0);
    }

    [data-reveal="badge"] {
      transform: translate3d(0, 12px, 0) scale(.96);
    }

    [data-reveal="highlight-item"],
    [data-reveal="value-item"] {
      transition-delay: var(--reveal-delay, 0ms);
    }

    [data-reveal].is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }

    [data-reveal="image"] img {
      transform: scale(1.045);
      transition: transform 1400ms cubic-bezier(.22,1,.36,1);
    }

    [data-reveal="image"].is-visible img {
      transform: scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal],
      [data-reveal="image"] img {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <script>
    const dineRevealItems = document.querySelectorAll("[data-reveal]");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      dineRevealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const dineObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.08,
          rootMargin: "0px 0px -7% 0px",
        }
      );

      dineRevealItems.forEach((item) => dineObserver.observe(item));
    }
  </script>

</section>