---

<section
  id="menu"
  class="relative overflow-hidden bg-[#F9F7F1] py-20 text-[#171714] sm:py-24 lg:py-[92px]"
>
  <!-- =========================================================
       BACKGROUND ATMOSPHERE
       ========================================================= -->

  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <!-- Extremely subtle warm glow -->
    <div
      class="absolute left-[-8%] top-[4%] h-[430px] w-[430px] rounded-full bg-[#A87343]/[0.035] blur-[90px]"
    ></div>

    <div
      class="absolute right-[-8%] top-[28%] h-[500px] w-[500px] rounded-full bg-[#737A4A]/[0.025] blur-[110px]"
    ></div>

    <!-- Bottom-right image atmosphere -->
    <div
      class="absolute -bottom-[160px] -right-[100px] h-[390px] w-[580px] overflow-hidden opacity-[0.14] blur-[1px]"
    >
      <!-- IMAGE PLACEHOLDER -->
      <img
        src="/images/menu/bottom-right-food.webp"
        alt=""
        class="h-full w-full object-cover"
      />

      <div class="absolute inset-0 bg-[#F9F7F1]/40"></div>
    </div>

    <!-- =======================================================
         TOP LEFT BLURRED BOTANICAL
         ======================================================= -->

    <div
      class="absolute -left-[80px] top-[80px] h-[260px] w-[160px] opacity-[0.18] blur-[10px]"
    >
      <div
        class="absolute left-[55px] top-0 h-[260px] w-[45px] rotate-[25deg] rounded-[50%] bg-[#737A4A]/20"
      ></div>

      <div
        class="absolute left-[20px] top-[80px] h-[130px] w-[65px] -rotate-[30deg] rounded-[50%] bg-[#737A4A]/15"
      ></div>
    </div>

    <!-- =======================================================
         BOTTOM LEFT LINE ART
         ======================================================= -->

    <svg
      viewBox="0 0 330 210"
      fill="none"
      class="absolute -bottom-3 left-[-25px] w-[300px] text-[#A87343]/20 sm:left-0 sm:w-[330px]"
      aria-hidden="true"
    >
      <path
        d="M4 203C38 161 67 125 105 105C137 88 177 76 220 78"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />

      <path
        d="M57 146C65 123 82 108 103 101C100 122 83 140 59 147"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <path
        d="M93 112C105 90 125 75 148 72C144 96 125 111 95 114"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <path
        d="M131 91C149 66 170 53 195 51C189 77 168 91 133 94"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <path
        d="M36 173C63 169 84 176 100 191C74 197 51 190 36 174"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <path
        d="M86 137C111 137 132 146 146 164C121 165 99 155 86 138"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <path
        d="M133 105C159 106 179 117 192 136C166 136 146 126 133 106"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>

  <!-- =========================================================
       MAIN CONTAINER
       ========================================================= -->

  <div class="mx-auto max-w-[1380px] px-5 sm:px-8 lg:px-10">
    <!-- =======================================================
         INTRO / CHEF AREA
         ======================================================= -->

    <div class="relative grid items-start gap-10 lg:grid-cols-[1fr_0.9fr]">
      <!-- LEFT -->
      <div class="relative z-10 pt-1">
        <!-- Eyebrow -->
        <div class="flex items-center gap-4">
          <span
            class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[#A87343]"
          >
            Signature Menu
          </span>

          <span class="h-px w-16 bg-[#A87343]/70"></span>
        </div>

        <!-- Heading -->
        <h2
          class="mt-5 max-w-[590px] font-['Cormorant_Garamond'] text-[clamp(3.7rem,5.4vw,5.2rem)] font-medium leading-[0.86] tracking-[-0.045em]"
        >
          <span class="block text-[#171714]">
            Chef’s Special
          </span>

          <span
            class="block bg-gradient-to-r from-[#A87343] via-[#B9793E] to-[#C99560] bg-clip-text text-transparent"
          >
            Creations
          </span>
        </h2>

        <!-- Description -->
        <p
          class="mt-5 max-w-[600px] text-[15px] leading-[1.55] text-[#4F4D48] sm:text-[17px]"
        >
          A culinary journey of handpicked dishes, crafted with the finest
          ingredients and inspired by rich traditions.
        </p>
      </div>

      <!-- =====================================================
           CHEF QUOTE / IMAGE
           ===================================================== -->

      <div
        class="relative hidden min-h-[250px] lg:block"
      >
        <!-- Quote -->
        <div
          class="absolute left-[4%] top-[32px] z-20 max-w-[250px]"
        >
          <p
            class="font-['Cormorant_Garamond'] text-[29px] font-medium italic leading-[1.08] tracking-[-0.02em] text-[#4D4A45]"
          >
            “Great food is
            <br />
            not just a meal,
            <br />
            it’s a memory.”
          </p>

          <div class="mt-5 flex items-center gap-3">
            <span class="h-px w-4 bg-[#A87343]"></span>

            <div>
              <p
                class="text-[10px] font-semibold uppercase tracking-[0.22em] text-[#292722]"
              >
                Chef Arjun
              </p>

              <p class="mt-1 text-[11px] text-[#77736B]">
                Executive Chef
              </p>
            </div>
          </div>

          <!-- Decorative arrow -->
          <svg
            viewBox="0 0 100 70"
            fill="none"
            class="absolute -right-[75px] top-[125px] w-[100px] text-[#8E5C35]"
            aria-hidden="true"
          >
            <path
              d="M2 6C26 12 40 27 51 42C59 53 68 59 82 60"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-dasharray="3 4"
            />

            <path
              d="M73 52L83 60L72 65"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>

        <!-- Chef image -->
        <div
          class="absolute right-[-20px] top-[-38px] h-[310px] w-[400px]"
        >
          <!-- Soft circular background -->
          <div
            class="absolute right-[50px] top-[30px] h-[245px] w-[245px] rounded-full bg-[#E9D2B8]/65"
          ></div>

          <!-- IMAGE PLACEHOLDER -->
          <img
            src="/images/chef.webp"
            alt=""
            class="relative z-10 h-full w-full object-cover object-bottom"
          />

          <!-- Botanical line art -->
          <svg
            viewBox="0 0 100 150"
            fill="none"
            class="absolute right-[-4px] top-[50px] z-20 h-[145px] w-[95px] text-[#A87343]/55"
            aria-hidden="true"
          >
            <path
              d="M15 143C20 105 43 75 75 55C87 47 94 37 98 23"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
            />

            <path
              d="M42 85C28 82 19 74 16 63C30 63 40 71 43 82"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
            />

            <path
              d="M59 69C56 54 62 43 73 34C77 48 71 60 61 70"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
            />

            <path
              d="M75 54C73 40 81 28 93 22C94 36 87 47 76 55"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
            />
          </svg>
        </div>
      </div>
    </div>

    <!-- =======================================================
         CATEGORY NAVIGATION
         ======================================================= -->

    <div
      class="mt-9 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none lg:mt-7"
    >
      {
        categories.map((category) => (
          <button
            type="button"
            data-category={category.label}
            class:list={[
              "category-btn group flex h-[46px] shrink-0 items-center gap-3 rounded-full px-5 text-[13px] transition-all duration-300",
              category.active
                ? "bg-[#A87343] text-white shadow-[0_8px_22px_rgba(168,115,67,0.18)] active-category"
                : "text-[#292722] hover:bg-[#A87343]/[0.07] hover:text-[#8E5C35]",
            ]}
          >
            <!-- CHEF ICON -->
            {category.icon === "chef" && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                class="h-[21px] w-[21px]"
                aria-hidden="true"
              >
                <path
                  d="M7 18V11.5C5.3 11.1 4 9.6 4 7.8C4 5.7 5.7 4 7.8 4C8.5 4 9.2 4.2 9.8 4.6C10.5 3.2 11.8 2.3 13.4 2.3C15.5 2.3 17.2 4 17.2 6.1C17.2 6.5 17.1 6.9 17 7.2C18.7 7.5 20 9 20 10.8C20 12.8 18.4 14.3 16.5 14.5V18"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

                <path
                  d="M7 18H17M8 18V21H16V18"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            )}

            <!-- LEAF -->
            {category.icon === "leaf" && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                class="h-[21px] w-[21px]"
                aria-hidden="true"
              >
                <path
                  d="M20 4C11 4 5 8.5 5 14.5C5 17.8 7.5 20 11 20C17 20 20 13 20 4Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />

                <path
                  d="M4 21C7 16 10 13 15 10"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            )}

            <!-- CLOCHE -->
            {category.icon === "cloche" && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                class="h-[21px] w-[21px]"
                aria-hidden="true"
              >
                <path
                  d="M4 17H20"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />

                <path
