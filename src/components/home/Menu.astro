     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

<!-- =========================================================
     MENU — SMOOTH SCROLL + REVEAL ANIMATIONS
     ========================================================= -->

<style>
  /* ---------------------------------------------------------
     Smooth page scrolling
     --------------------------------------------------------- */

  html {
    scroll-behavior: smooth;
  }

  /* ---------------------------------------------------------
     Reveal base state
     --------------------------------------------------------- */

  #menu .menu-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  #menu .menu-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------------------------------------------------------
     Slightly different movement for the chef area
     --------------------------------------------------------- */

  #menu .menu-reveal-chef {
    opacity: 0;
    transform: translateY(18px) scale(0.985);
    transition:
      opacity 850ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 850ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  #menu .menu-reveal-chef.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* ---------------------------------------------------------
     Dish cards — softer and slightly staggered
     --------------------------------------------------------- */

  #menu .menu-reveal-card {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  #menu .menu-reveal-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------------------------------------------------------
     Category navigation
     --------------------------------------------------------- */

  #menu .menu-reveal-nav {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 600ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #menu .menu-reveal-nav.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------------------------------------------------------
     Bottom CTA
     --------------------------------------------------------- */

  #menu .menu-reveal-cta {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #menu .menu-reveal-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------------------------------------------------------
     Reduced motion
     --------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    #menu .menu-reveal,
    #menu .menu-reveal-chef,
    #menu .menu-reveal-card,
    #menu .menu-reveal-nav,
    #menu .menu-reveal-cta {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const initMenuAnimations = () => {
      const menu = document.querySelector("#menu");

      if (!menu) return;

      /*
       * Prevent duplicate initialization
       */
      if (menu.dataset.animationsInitialized === "true") return;

      menu.dataset.animationsInitialized = "true";

      /* -------------------------------------------------------
         Identify existing elements
         ------------------------------------------------------- */

      const mainContainer = menu.querySelector(
        ":scope > div.mx-auto"
      );

      if (!mainContainer) return;

      const introArea = mainContainer.children[0];
      const categoryNav = mainContainer.children[1];
      const cardsWrapper = mainContainer.children[2];
      const bottomCta = mainContainer.children[3];

      /* -------------------------------------------------------
         Intro / heading
         ------------------------------------------------------- */

      if (introArea) {
        introArea.classList.add("menu-reveal");
      }

      /* -------------------------------------------------------
         Chef image + quote get a slightly softer animation
         ------------------------------------------------------- */

      if (introArea) {
        const chefArea = introArea.querySelector(
          ".hidden.lg\\:block"
        );

        if (chefArea) {
          chefArea.classList.remove("menu-reveal");
          chefArea.classList.add("menu-reveal-chef");
        }
      }

      /* -------------------------------------------------------
         Category navigation
         ------------------------------------------------------- */

      if (categoryNav) {
        categoryNav.classList.add("menu-reveal-nav");
      }

      /* -------------------------------------------------------
         Dish cards
         ------------------------------------------------------- */

      if (cardsWrapper) {
        const cards = cardsWrapper.querySelectorAll("article");

        cards.forEach((card, index) => {
          card.classList.add("menu-reveal-card");

          /*
           * Maximum stagger is kept small so the section
           * doesn't feel slow.
           */
          card.style.setProperty(
            "--reveal-delay",
            `${index * 80}ms`
          );
        });
      }

      /* -------------------------------------------------------
         Bottom CTA
         ------------------------------------------------------- */

      if (bottomCta) {
        bottomCta.classList.add("menu-reveal-cta");
      }

      /* -------------------------------------------------------
         Intersection Observer
         ------------------------------------------------------- */

      const animatedElements = menu.querySelectorAll(
        ".menu-reveal, .menu-reveal-chef, .menu-reveal-nav, .menu-reveal-card, .menu-reveal-cta"
      );

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (prefersReducedMotion) {
        animatedElements.forEach((element) => {
          element.classList.add("is-visible");
        });

        return;
      }

      const observer = new IntersectionObserver(
        (entries, observerInstance) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add("is-visible");

            /*
             * Animate only once.
             */
            observerInstance.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -60px 0px",
        }
      );

      animatedElements.forEach((element) => {
        observer.observe(element);
      });
    };

    /*
     * Astro can execute scripts after the DOM is available,
     * but this also makes it safe when the component is
     * dynamically inserted.
     */
    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        initMenuAnimations,
        { once: true }
      );
    } else {
      initMenuAnimations();
    }
  })();
</script>