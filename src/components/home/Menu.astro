<script>
  document.addEventListener('DOMContentLoaded', () => {
    const categoryBtns = document.querySelectorAll('.category-btn');
    const dishCards = document.querySelectorAll('.dish-card');

    function filterDishes(category) {
      dishCards.forEach((card) => {
        if (card.getAttribute('data-category') === category) {
          card.style.display = 'block';
          // Slight timeout to ensure display: block applies before opacity transitions
          setTimeout(() => {
            card.style.opacity = '1';
          }, 10);
        } else {
          card.style.opacity = '0';
          setTimeout(() => {
            card.style.display = 'none';
          }, 300); // Matches typical transition speed
        }
      });
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Reset all buttons to inactive state
        categoryBtns.forEach((b) => {
          b.classList.remove('bg-[#A87343]', 'text-white', 'shadow-[0_8px_22px_rgba(168,115,67,0.18)]', 'active-category');
          b.classList.add('text-[#292722]', 'hover:bg-[#A87343]/[0.07]', 'hover:text-[#8E5C35]');
        });

        // Set clicked button to active state
        btn.classList.remove('text-[#292722]', 'hover:bg-[#A87343]/[0.07]', 'hover:text-[#8E5C35]');
        btn.classList.add('bg-[#A87343]', 'text-white', 'shadow-[0_8px_22px_rgba(168,115,67,0.18)]', 'active-category');

        // Filter dishes based on selected category
        const selectedCategory = btn.getAttribute('data-category');
        filterDishes(selectedCategory);
      });
    });

    // Run initial filter based on default active button
    const activeBtn = document.querySelector('.category-btn.active-category');
    if (activeBtn) {
      filterDishes(activeBtn.getAttribute('data-category'));
    }
  });
</script>

<style>
  /* =========================================================
