---

---

<section id="about" class="relative overflow-hidden bg-[#FDFBF7] py-20 text-[#171714] sm:py-24 lg:py-[120px]">
  <!-- Background Botanical Watermarks -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <!-- Top Left Leaves -->
    <svg viewBox="0 0 200 200" class="absolute -left-10 -top-10 h-64 w-64 text-[#D7CCC0] opacity-30" fill="currentColor" aria-hidden="true">
      <path d="M100 0C100 55.23 55.23 100 0 100C55.23 100 100 144.77 100 200C100 144.77 144.77 100 200 100C144.77 100 100 55.23 100 0Z" />
      <path d="M50 20C50 40 30 50 10 50C30 50 50 70 50 90C50 70 70 50 90 50C70 50 50 40 50 20Z" opacity="0.5"/>
    </svg>
    <!-- Bottom Right Leaves -->
    <svg viewBox="0 0 200 200" class="absolute -bottom-20 -right-20 h-96 w-96 text-[#D7CCC0] opacity-40" fill="currentColor" aria-hidden="true">
      <path d="M100 0C100 55.23 55.23 100 0 100C55.23 100 100 144.77 100 200C100 144.77 144.77 100 200 100C144.77 100 100 55.23 100 0Z" />
    </svg>
  </div>

  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10">
    <div class="grid items-center gap-16 lg:grid-cols-[1fr_1.1fr] lg:gap-8">
      
      <!-- ==========================================
           LEFT COLUMN: TEXT & FEATURES
           ========================================== -->
      <div class="relative z-10 lg:pr-8">
        
        <!-- Eyebrow -->
        <div class="flex items-center gap-4">
          <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-[#A87343]">
            About Foresto Paradise
          </span>
          <span class="h-px w-16 bg-[#A87343]/60"></span>
        </div>

        <!-- Heading -->
        <h2 class="mt-6 font-['Cormorant_Garamond'] text-[clamp(3.5rem,5vw,5.5rem)] font-medium leading-[1.05] tracking-[-0.02em] text-[#171714]">
          More Than <br />
          <span class="text-[#A87343]">Just a Meal</span>
        </h2>

        <!-- Description -->
        <p class="mt-6 max-w-[500px] text-[16px] leading-[1.6] text-[#5A5752] sm:text-[18px]">
          At Foresto Paradise, we bring together delightful flavours, warm hospitality and a beautiful ambiance to create memorable dining experiences for every occasion.
        </p>

        <!-- Features Grid -->
        <div class="mt-12 flex flex-wrap gap-y-8 divide-x divide-[#E5DED5]">
          <!-- Feature 1 -->
          <div class="flex flex-col items-center px-6 text-center first:pl-0">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#F5EFE6] text-[#A87343]">
              <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true">
                <path d="M11 4V16M11 16H8M11 16H14M8 16V20M14 16V20M5 4C5 7.31371 7.68629 10 11 10M17 4C17 7.31371 14.3137 10 11 10M11 10V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h4 class="font-serif text-[18px] font-semibold text-[#171714]">Authentic<br/>Flavours</h4>
            <p class="mt-2 max-w-[120px] text-[13px] leading-snug text-[#7A756D]">Carefully crafted by expert chefs</p>
          </div>

          <!-- Feature 2 -->
          <div class="flex flex-col items-center px-6 text-center">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#F5EFE6] text-[#A87343]">
              <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true">
                <path d="M17 20C17 18.3431 14.7614 17 12 17C9.23858 17 7 18.3431 7 20M12 13C9.79086 13 8 11.2091 8 9C8 6.79086 9.79086 5 12 5C14.2091 5 16 6.79086 16 9C16 11.2091 14.2091 13 12 13ZM21 19C21 17.8954 19.8807 17 18.5 17C17.1193 17 16 17.8954 16 19M19 14C17.8954 14 17 13.1046 17 12C17 10.8954 17.8954 10 19 10C20.1046 10 21 10.8954 21 12C21 13.1046 20.1046 14 19 14ZM5 19C5 17.8954 3.88071 17 2.5 17C1.11929 17 0 17.8954 0 19M5 14C3.89543 14 3 13.1046 3 12C3 10.8954 3.89543 10 5 10C6.10457 10 7 10.8954 7 12C7 13.1046 6.10457 14 5 14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h4 class="font-serif text-[18px] font-semibold text-[#171714]">A Place<br/>for Everyone</h4>
            <p class="mt-2 max-w-[130px] text-[13px] leading-snug text-[#7A756D]">Perfect for families, friends and celebrations</p>
          </div>

          <!-- Feature 3 -->
          <div class="flex flex-col items-center px-6 text-center pr-0">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#F5EFE6] text-[#A87343]">
              <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true">
                <path d="M21 4C12 4 5 9.5 5 16.5C5 20.4 8 23 12 23C19 23 23 14.5 23 4ZM4 24C7.5 18 11.5 14.5 17.5 11" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>
              </svg>
            </div>
            <h4 class="font-serif text-[18px] font-semibold text-[#171714]">Warm<br/>Ambiance</h4>
            <p class="mt-2 max-w-[130px] text-[13px] leading-snug text-[#7A756D]">A comfortable space to relax and unwind</p>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="mt-12">
          <a href="/our-story" class="group inline-flex h-14 items-center gap-4 rounded-full bg-gradient-to-r from-[#AD7A48] to-[#996536] px-8 text-[15px] font-medium text-white shadow-[0_8px_20px_rgba(168,115,67,0.25)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_25px_rgba(168,115,67,0.35)]">
            Our Story
            <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
              <path d="M5 12H19M13 6L19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- ==========================================
           RIGHT COLUMN: IMAGE COLLAGE & GLASSMORPHISM
           ========================================== -->
      <div class="relative z-10 mt-10 w-full lg:mt-0">
        <div class="relative mx-auto aspect-[4/5] w-full max-w-[550px] lg:mr-auto lg:ml-0">
          
          <!-- Main Large Image -->
          <div class="absolute bottom-0 left-0 top-0 w-[75%] overflow-hidden rounded-[32px] shadow-2xl">
            <img src="https://images.unsplash.com/photo-1729394405518-eaf2a0203aa7?q=80&w=1331&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Beautiful restaurant interior" class="h-full w-full object-cover" />
            <div class="absolute inset-0 bg-black/5"></div>
          </div>

          <!-- Glassmorphic Quote Card (Top Right) -->
          <div class="absolute -right-4 top-8 z-20 w-[260px] rounded-[24px] border border-white/10 bg-gradient-to-br from-[#4A423A]/50 to-[#2A2520]/50 p-6 shadow-[0_20px_40px_rgba(0,0,0,0.15)] backdrop-blur-xl sm:-right-8 md:w-[300px] md:p-8">
            <p class="font-['Cormorant_Garamond'] text-[24px] italic leading-[1.2] text-white md:text-[28px]">
              “Good food brings people together.”
            </p>
            <div class="mt-6 flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#D4C3B3]">Our Philosophy</span>
            </div>
            <!-- Decorative minimal leaf inside card -->
            <svg viewBox="0 0 24 24" fill="none" class="absolute bottom-4 right-4 h-16 w-16 text-white/5" aria-hidden="true">
              <path d="M21 4C12 4 5 9.5 5 16.5C5 20.4 8 23 12 23C19 23 23 14.5 23 4ZM4 24C7.5 18 11.5 14.5 17.5 11" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
            </svg>
          </div>

          <!-- Floating Stacked Images (Right Edge) -->
          <div class="absolute bottom-[25%] right-0 z-10 flex flex-col gap-4 sm:-right-12">
            <img src="https://plus.unsplash.com/premium_photo-1673809798970-30c14cfd0ab6?q=80&w=764&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Signature dish" class="h-[140px] w-[140px] rounded-[20px] object-cover shadow-lg border border-white/40 md:h-[180px] md:w-[180px]" />
            <img src="https://images.unsplash.com/photo-1563227812-0ea4c22e6cc8?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NHx8ZHJpbmtzfGVufDB8fDB8fHww" alt="Ambiance" class="h-[140px] w-[140px] rounded-[20px] object-cover shadow-lg border border-white/40 md:h-[180px] md:w-[180px]" />
          </div>

          <!-- Glassmorphic Social Proof / Rating Card (Bottom Center/Left) -->
          <!-- Adjusted Patna to Pune based on target market context[cite: 2] -->
          <div class="absolute -bottom-8 left-[10%] z-30 flex w-[280px] items-center gap-5 rounded-[20px] border border-white/60 bg-white/70 p-4 shadow-[0_15px_35px_rgba(0,0,0,0.08)] backdrop-blur-md md:w-[340px] md:p-5">
            <!-- Avatars -->
            <div class="flex -space-x-3 shrink-0">
              <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8YXZhdGFyfGVufDB8fDB8fHww" alt="Diner" class="h-10 w-10 rounded-full border-2 border-white object-cover shadow-sm" />
              <img src="https://images.unsplash.com/photo-1599566150163-29194dcaad36?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Nnx8YXZhdGFyfGVufDB8fDB8fHww" alt="Diner" class="h-10 w-10 rounded-full border-2 border-white object-cover shadow-sm" />
              <img src="https://images.unsplash.com/photo-1701615004837-40d8573b6652?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8OHx8YXZhdGFyfGVufDB8fDB8fHww" alt="Diner" class="h-10 w-10 rounded-full border-2 border-white object-cover shadow-sm" />
              <img src="https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTF8fGF2YXRhcnxlbnwwfHwwfHx8MA%3D%3D" alt="Diner" class="h-10 w-10 rounded-full border-2 border-white object-cover shadow-sm" />
            </div>
            
            <!-- Rating Info -->
            <div class="flex w-full items-center justify-between border-l border-[#E5DED5] pl-5">
              <div>
                <p class="font-serif text-[22px] font-bold leading-none text-[#171714]">2K+</p>
                <p class="mt-1 text-[11px] leading-tight text-[#7A756D]">Happy Diners<br/>Across Pune</p>
              </div>
              <div class="text-right">
                <div class="flex items-center gap-0.5 text-[#F2B04E]">
                  <!-- 5 Stars -->
                  <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                </div>
                <p class="mt-1 text-[11px] leading-tight text-[#7A756D]">4.8/5 Rating<br/>on Google</p>
              </div>
            </div>
          </div>

          <!-- Decorative Arrow & Handwritten Text -->
          <div class="absolute -bottom-[70px] -right-[30px] z-20 flex flex-col items-center sm:-bottom-[80px] sm:-right-[10px]">
            <svg viewBox="0 0 100 80" fill="none" class="h-16 w-16 -rotate-12 text-[#B3875E]" aria-hidden="true">
              <path d="M20 70 Q 30 20 80 10" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
              <path d="M70 5 L 82 9 L 75 20" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <p class="mt-2 -rotate-12 font-['Caveat',cursive,serif] text-[24px] italic leading-tight text-[#A87343] sm:text-[28px]">
              Good Food<br/>Brighter Moments
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Ensure the elegant fonts are imported. 
     Caveat is used to perfectly mimic the handwriting in the bottom right. */
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap');
  
  /* Additional polish for the glassmorphism blur effect rendering across browsers */
  .backdrop-blur-xl {
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }
  .backdrop-blur-md {
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
</style>

<!-- =========================================================
     MENU — SMOOTH SCROLL + SOFT REVEAL SYSTEM
     ========================================================= -->

<style>
  /* ---------------------------------------------------------
     Smooth scrolling
     --------------------------------------------------------- */

  html {
    scroll-behavior: smooth;
  }

  /* ---------------------------------------------------------
     Main section reveal
     --------------------------------------------------------- */

  #about .menu-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 750ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 750ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  #about .menu-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------------------------------------------------------
     Softer image / chef visual reveal
     --------------------------------------------------------- */

  #about .menu-reveal-image {
    opacity: 0;
    transform: translateY(20px) scale(0.985);
    transition:
      opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  #about .menu-reveal-image.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* ---------------------------------------------------------
     Category navigation
     --------------------------------------------------------- */

  #about .menu-reveal-nav {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  #about .menu-reveal-nav.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------------------------------------------------------
     Dish cards
     --------------------------------------------------------- */

  #about .dish-card.menu-reveal-card {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 500ms ease;
    transition-delay: var(--menu-delay, 0ms);
    will-change: opacity, transform;
  }

  #about .dish-card.menu-reveal-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------------------------------------------------------
     Bottom CTA
     --------------------------------------------------------- */

  #about .menu-reveal-cta {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  #about .menu-reveal-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------------------------------------------------------
     Subtle image hover
     --------------------------------------------------------- */

  #about .dish-card img {
    transition:
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #about .dish-card:hover img {
    transform: scale(1.025);
  }

  /* ---------------------------------------------------------
     Reduced motion
     --------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    #about .menu-reveal,
    #about .menu-reveal-image,
    #about .menu-reveal-nav,
    #about .dish-card.menu-reveal-card,
    #about .menu-reveal-cta {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #about .dish-card img {
      transition: none;
    }
  }
</style>

<style>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }

  #about {
    --reveal-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  #about .reveal,
  #about .reveal-soft,
  #about .reveal-scale {
    opacity: 0;
    will-change: opacity, transform;
  }

  #about .reveal {
    transform: translate3d(0, 28px, 0);
    transition:
      opacity 800ms var(--reveal-ease),
      transform 800ms var(--reveal-ease);
  }

  #about .reveal-soft {
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 900ms var(--reveal-ease),
      transform 900ms var(--reveal-ease);
  }

  #about .reveal-scale {
    transform: translate3d(0, 18px, 0) scale(0.985);
    transition:
      opacity 1000ms var(--reveal-ease),
      transform 1000ms var(--reveal-ease);
  }

  #about .reveal.is-visible,
  #about .reveal-soft.is-visible,
  #about .reveal-scale.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  #about [data-reveal-delay="1"] { transition-delay: 80ms; }
  #about [data-reveal-delay="2"] { transition-delay: 160ms; }
  #about [data-reveal-delay="3"] { transition-delay: 240ms; }
  #about [data-reveal-delay="4"] { transition-delay: 320ms; }

  #about img {
    transition: transform 1200ms var(--reveal-ease);
  }

  #about .about-image:hover img {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    #about .reveal,
    #about .reveal-soft,
    #about .reveal-scale {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #about img {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const initAboutReveal = () => {
      const section = document.querySelector("#about");
      if (!section || section.dataset.revealInitialized === "true") return;

      section.dataset.revealInitialized = "true";

      const grid = section.querySelector(":scope > div.mx-auto > div");
      if (!grid) return;

      const left = grid.children[0];
      const right = grid.children[1];

      /*
       * Left side:
       * eyebrow → heading → description → features → CTA
       */
      if (left) {
        const eyebrow = left.children[0];
        const heading = left.querySelector("h2");
        const description = left.querySelector("p");
        const features = left.querySelector(":scope > div.mt-12");
        const cta = left.querySelector(":scope > div.mt-12:last-child");

        [eyebrow, heading, description].forEach((el) => {
          if (el) el.classList.add("reveal");
        });

        if (features) {
          [...features.children].forEach((feature, index) => {
            feature.classList.add("reveal-soft");
            if (index > 0) {
              feature.dataset.revealDelay = String(Math.min(index, 4));
            }
          });
        }

        if (cta) {
          cta.classList.add("reveal");
          cta.dataset.revealDelay = "2";
        }
      }

      /*
       * Right side:
       * main visual + quote card + floating images + social proof + annotation
       */
      if (right) {
        const visual = right.querySelector(":scope > div.relative");

        if (visual) {
          visual.classList.add("reveal-scale", "about-image");

          const quote = visual.querySelector(":scope > div.absolute.-right-4");
          const floatingImages = visual.querySelector(
            ":scope > div.absolute.bottom-\\[25\\%\\]"
          );
          const socialProof = visual.querySelector(
            ":scope > div.absolute.-bottom-8"
          );
          const annotation = visual.querySelector(
            ":scope > div.absolute.-bottom-\\[70px\\]"
          );

          [quote, floatingImages, socialProof, annotation].forEach((el, index) => {
            if (!el) return;
            el.classList.add("reveal-soft");
            el.dataset.revealDelay = String(Math.min(index + 1, 4));
          });
        }
      }

      const elements = section.querySelectorAll(
        ".reveal, .reveal-soft, .reveal-scale"
      );

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (reduceMotion) {
        elements.forEach((element) => {
          element.classList.add("is-visible");
        });
        return;
      }

      const observer = new IntersectionObserver(
        (entries, observerInstance) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add("is-visible");
            observerInstance.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -60px 0px",
        }
      );

      elements.forEach((element) => observer.observe(element));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAboutReveal, {
        once: true,
      });
    } else {
      initAboutReveal();
    }
  })();
</script>