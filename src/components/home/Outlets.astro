        <path d="M2 10 Q 40 2 80 12 T 148 8" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      </svg>
    </div>
  </div>

  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-10">
    
